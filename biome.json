{
    "$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": ["**"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedImports": "warn",
                "noUnusedVariables": "warn",
                "noUnusedFunctionParameters": "warn"
            },
            "style": {
                "useThrowNewError": "warn",
                "useThrowOnlyError": "warn",
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "requireAscii": true,
                        "strictCase": false,
                        "conventions": [
                            {
                                "match": ".*_via_.*|(.*)"
                            }
                        ]
                    }
                },
                "useConsistentArrayType": {
                    "level": "error",
                    "options": { "syntax": "shorthand" }
                }
            },
            "suspicious": {
                "noExplicitAny": "off"
            }
        },
        "includes": ["**", "!**/*.vue", "!**/pocketbase-types.ts"]
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "single",
            "jsxQuoteStyle": "single"
        }
    }
}
